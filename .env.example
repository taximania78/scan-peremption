# Copiez ce fichier vers .env et renseignez vos valeurs.

# Base de données SQLite (Prisma)
DATABASE_URL="file:./prisma/data/dev.db"

# Clé API OpenRouter pour la reformulation des noms de produits.
# Obtenez-en une sur https://openrouter.ai/keys
# Optionnel : si absente, le nom du produit est conservé tel quel.
OPENROUTER_API_KEY=""

# En-têtes d'attribution OpenRouter (optionnels)
APP_URL="http://localhost:3000"
APP_TITLE="Scan Peremption"

# User-Agent envoyé à l'API Open Food Facts.
# Format requis : AppName/Version (Contact email ou URL)
OFF_USER_AGENT="ScanPeremption/1.0 (https://github.com/your-org/scan-peremption)"
